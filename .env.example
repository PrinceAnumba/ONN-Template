# Empty = mocks. Set to a backend implementing docs/onn-frontend-prompt.md §3.
NEXT_PUBLIC_API_BASE=
# Picks packages/config/countries/{ISO3}.ts and packages/mocks/fixtures/{ISO3}.
NEXT_PUBLIC_COUNTRY=SEN
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Where the portal forwards /admin (Next.js multi-zones).
ADMIN_ORIGIN=http://localhost:3001
# Mock server, used when NEXT_PUBLIC_API_BASE is empty.
MOCK_API_ORIGIN=http://localhost:4000
MOCK_PORT=4000
# Set to 0 to turn off the 150-600 ms random latency.
MOCK_LATENCY=
# Publish webhook: the backend (or the mock) posts cache tags to the portal's /api/revalidate
# with this secret in X-Revalidate-Secret. Change it in production.
REVALIDATE_SECRET=dev-revalidate
# Mock only: the apps' webhook URLs, comma-separated.
REVALIDATE_URLS=http://localhost:3000/api/revalidate
