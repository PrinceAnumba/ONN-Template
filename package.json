{
  "name": "onn-frontend",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=./apps/* --filter=@onn/mocks",
    "dev:portal": "turbo run dev --filter=@onn/portal --filter=@onn/mocks",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mocks:gen": "pnpm --filter @onn/mocks gen",
    "storybook": "pnpm --filter @onn/config --filter @onn/charts build && pnpm --filter @onn/storybook storybook",
    "build-storybook": "pnpm --filter @onn/config --filter @onn/charts build && pnpm --filter @onn/storybook build-storybook",
    "check:stories": "pnpm --filter @onn/storybook check-states",
    "e2e": "pnpm --filter @onn/e2e e2e",
    "visual": "pnpm --filter @onn/e2e visual",
    "budgets": "pnpm --filter @onn/e2e budgets",
    "lhci": "pnpm --filter @onn/e2e lhci"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "15.5.29",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
